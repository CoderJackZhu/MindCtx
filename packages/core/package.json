{
  "name": "@minddoc/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "unified": "^11",
    "remark-parse": "^11",
    "remark-frontmatter": "^5",
    "remark-gfm": "^4",
    "remark-math": "^6",
    "yaml": "^2",
    "mind-elixir": "^4.0"
  },
  "devDependencies": {
    "typescript": "^5.4",
    "tsup": "^8",
    "vitest": "^2.0",
    "@types/node": "^20"
  }
}
